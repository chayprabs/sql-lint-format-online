{
  "name": "sql-lint-format-online",
  "private": true,
  "version": "1.0.0",
  "description": "Lint, format and rewrite SQL online across PostgreSQL, MySQL, Snowflake and BigQuery with risky-query warnings and safe rewrites.",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @sqlguard/web dev",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @sqlguard/web test:e2e",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.3",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "prettier": "^3.8.4",
    "typescript-eslint": "^8.61.1"
  }
}
